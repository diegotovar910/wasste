# --- Wasste server configuration -------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
# Without it the server still runs: classification falls back to a clearly
# labelled DEMO result and the sustainability agent falls back to rule-based
# recommendations.
GEMINI_API_KEY=

# Gemini model used for both vision classification and agent reasoning.
# Note: gemini-2.5-flash is no longer available to new API keys.
GEMINI_MODEL=gemini-3.7-flash

# Tried in order when the preferred model returns "high demand" (503).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/wasste

# API port.
PORT=5000

# Comma separated list of allowed browser origins (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
